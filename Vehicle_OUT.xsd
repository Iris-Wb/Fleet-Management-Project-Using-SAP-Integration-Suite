<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="vehicle">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="model" type="xs:string" />
        <xs:element name="year" type="xs:unsignedShort" />
        <xs:element name="imageURL" type="xs:string" />
        <xs:element name="licensePlate" type="xs:string" />
        <xs:element name="renavam" type="xs:unsignedLong" />
        <xs:element name="mileage" type="xs:unsignedShort" />
        <xs:element name="status" type="xs:string" />
        <xs:element name="lastInspection" type="xs:unsignedInt" />
        <xs:element name="nextInspection" type="xs:unsignedInt" />
        <xs:element name="dailyRate" type="xs:unsignedByte" />
        <xs:element name="monthlyRate" type="xs:decimal" />
        <xs:element name="createdAt" type="xs:unsignedInt" />
        <xs:element name="vehicleId" type="xs:unsignedByte" />
        <xs:element name="fleetId" type="xs:unsignedByte" />
        <xs:element name="detail">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="make">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="value" type="xs:string" />
                    <xs:element name="count" type="xs:unsignedByte" />
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="body">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="value" type="xs:string" />
                    <xs:element name="count" type="xs:unsignedByte" />
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>